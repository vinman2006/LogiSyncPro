# LogiSync Pro — Environment Variables Template
# ============================================================

# 1. Firebase Authentication & Identity
# ============================================================
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=logisyncpro.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=logisyncpro
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=logisyncpro.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=996335227020
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id_here
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id_here

# 2. Neon PostgreSQL Database (Server-side ONLY)
# ============================================================
# Connect via pooled or direct connection string:
# postgres://[user]:[password]@[neon_hostname]/[dbname]?sslmode=require
DATABASE_URL=postgres://neondb_owner:npg_placeholder@ep-cool-fog-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# 3. Razorpay Settlement Gateway
# ============================================================
# Razorpay Test Key ID (exposed client-side for checkout script)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_placeholder_key_id

# Razorpay Test Secret (server-side ONLY for HMAC signature verification)
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=rzp_test_placeholder_key_secret

# 4. Web3 & Blockchain Settlement Networks (Testnet)
# ============================================================
# EVM Chain ID: 11155111 (Sepolia) or 80002 (Polygon Amoy)
NEXT_PUBLIC_EVM_CHAIN_ID=11155111
NEXT_PUBLIC_EVM_RPC_URL=https://rpc.sepolia.org
NEXT_PUBLIC_EVM_ESCROW_CONTRACT=0x742d35Cc6634C0532925a3b844Bc454e4438f44e

# Stellar Horizon Testnet
NEXT_PUBLIC_STELLAR_NETWORK=TESTNET
NEXT_PUBLIC_STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
